
# 🌐 Webapp Configuration - Points to your proxy server

API_BASE_URL=http://localhost:3000
STT_RELAY_URL=ws://localhost:8080

# Optional: transcription language override (defaults to en)
OPENAI_TRANSCRIBE_LANG=en

# Apple notarization (macOS builds)
APPLE_ID=email
APPLE_APP_SPECIFIC_PASSWORD=password
APPLE_TEAM_ID=id

# Release / code signing (CI secrets; only needed for local signed builds)
CSC_LINK=
CSC_KEY_PASSWORD=
RELEASE_TOKEN=
