{
    "name": "whisper",
    "productName": "Whisper",
    "version": "1.7.0",
    "description": "Whisper AI Assistant",
    "main": "src/index.js",
    "scripts": {
        "setup": "pnpm install && pnpm run build:all && pnpm start",
        "start": "pnpm run build:renderer && electron .",
        "package": "pnpm run build:all && electron-builder --dir",
        "package:e2e": "pnpm run build:all && electron-builder --config tests/e2e/electron-builder.e2e.yml --mac --dir --publish never",
        "build": "pnpm run build:all && electron-builder --config electron-builder.yml --publish never",
        "build:win": "pnpm run build:all && electron-builder --win --x64 --publish never",
        "dist:mac": "pnpm run build:all && electron-builder --mac --publish never && node scripts/add-mac-feed-minimum-system-version.js",
        "release:mac": "pnpm run dist:mac && node scripts/release-mac.js",
        "dist:win": "pnpm run build:all && electron-builder --win --publish never",
        "dist:linux": "pnpm run build:all && electron-builder --linux --publish never",
        "dist:all": "pnpm run build:all && electron-builder --mac --win --linux --publish never",
        "lint": "eslint --ext .ts,.tsx,.js .",
        "web:lint": "pnpm --filter whisper-frontend run lint",
        "type-check": "tsc -p tsconfig.json && tsc -p tests/e2e/tsconfig.json && pnpm run web:type-check",
        "web:type-check": "pnpm --filter whisper-frontend run type-check",
        "build:renderer": "node build.js",
        "build:web": "pnpm --filter whisper-frontend run build",
        "build:all": "pnpm run build:renderer && pnpm run build:web",
        "watch:renderer": "node build.js --watch",
        "test": "vitest run && pnpm run test:jest",
        "test:jest": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest tests/unit",
        "test:integration": "jest tests/integration",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "PWDEBUG=1 playwright test",
        "release": "node scripts/auto-release.js"
    },
    "keywords": [
        "whisper",
        "ai assistant",
        "real-time",
        "live summary",
        "contextual ai"
    ],
    "author": {
        "name": "Whisper Team",
        "email": "support@whisper.app"
    },
    "license": "GPL-3.0",
    "engines": {
        "node": "^26.13.1"
    },
    "packageManager": "pnpm@12.23.0",
    "dependencies": {
        "better-sqlite3": "^13.2.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.12",
        "express": "^5.3.0",
        "sharp": "^0.35.5",
        "ws": "^8.23.0"
    },
    "devDependencies": {
        "@electron/notarize": "^3.1.2",
        "@jest/globals": "^29.7.0",
        "@playwright/test": "^1.65.1",
        "@types/jest": "^29.5.11",
        "@types/node": "^26.6.11",
        "@types/ws": "^8.18.2",
        "electron": "^45.5.0",
        "electron-builder": "^26.18.1",
        "esbuild": "^0.28.2",
        "jest": "^29.7.0",
        "jest-environment-node": "^29.7.0",
        "js-yaml": "^4.3.2",
        "jsdom": "^31.0.1",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "typescript": "6.0.3",
        "vite": "^8.4.0",
        "vitest": "^5.1.2"
    }
}
